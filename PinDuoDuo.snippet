#!name = 拼多多去广告（Quantumult X 原生全量版）
#!desc = 开屏拦截、底栏精简、全局弹窗、首页/个人中心/订单页推广清理。代码原创，不引用任何 Loon 插件。
#!author = Rumi for Nero
#!date = 2026-11-11
#!version = 2.0
# 礼仪说明：本文件为独立原创实现，未复制/转写 ZenmoFeiShi、可莉的任何文件；
# 底栏/弹窗净化方向与 ZenmoFeiShi/Qx 原生 snippet 一致，特此致谢（原版见其仓库）。
# 与可莉的 Loon 插件无代码关系，未使用其分发资源。仅供个人学习自用。

# ============ 使用前必读 ============
# 1. 把 kenny53/kk_mod 换成实际仓库路径（托管完成后由维护者统一替换）。
# 2. QX 中开启重写 + MITM 并信任证书；确认下方 hostname 已并入 MITM 名单。
# 3. 同一 App 不要叠加其它拼多多重写（薯条 ZenmoFeiShi/Qx 的 Pinduoduo.snippet
#    与本文件覆盖重叠，二选一即可）。

# --- 第一层：纯推广接口，直接拦截 ---

# 开屏广告
^https?:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/cappuccino\/splash url reject

# 个人中心活动推广流（纯推广接口，返回空字典避免报错重试）
^https?:\/\/api\.pinduoduo\.com\/api\/ktt_gateway\/activity\/feeds\/personal_home_page\/ url reject-dict

# --- 第二层：响应体清理（统一脚本，按接口分流处理） ---

^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub\? url script-response-body https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_clean.js
^https:\/\/api\.pinduoduo\.com\/api\/oak\/integration\/render\? url script-response-body https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_clean.js
^https:\/\/api\.pinduoduo\.com\/api\/philo\/personal\/hub\? url script-response-body https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_clean.js
^https:\/\/api\.pinduoduo\.com\/api\/(aquarius|flow)\/hungary\/(window\/)?global\/ url script-response-body https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_clean.js
^https:\/\/api\.pinduoduo\.com\/api\/growth\/nagato\/app\/index\/gather url script-response-body https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_clean.js
^https:\/\/api\.pinduoduo\.com\/search\? url script-response-body https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_clean.js
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/order_detail_group\? url script-response-body https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_clean.js
^https:\/\/api\.pinduoduo\.com\/api\/aristotle\/order_list_v4\? url script-response-body https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_clean.js
^https:\/\/api\.pinduoduo\.com\/order\/ url script-response-body https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_clean.js

hostname = api.pinduoduo.com, api.yangkeduo.com
