#!name = 【调试版】拼多多去广告（会弹通知）
#!desc = v4.3 与主版规则相同，脚本处理接口时弹通知报告命中与删除结果，并在原始响应中搜底栏标记。调试完换回主版。
#!author = Rumi for Nero
#!date = 2026-11-12
#!version = 4.0
# 礼仪说明：本文件为独立原创实现，未复制/转写任何第三方插件的规则或脚本文本。
# 底栏/弹窗净化方向与 Titan 拦截思路参考 ZenmoFeiShi/Qx，特此致谢；
# v4.0 补充的接口/字段清单参考公开 Surge 模块披露的拼多多接口结构事实，实现为本仓原创。
# 仅供个人学习自用。

# ============ 使用前必读 ============
# 1. 【必需】分流 → 引用 添加 PinDuoDuo_filter.list（不要设策略覆盖，排在宽泛直连之前）。
# 2. 本文件加在「重写 → 引用」，开启重写 + MitM 并信任证书。
# 3. [general] 建议 udp_whitelist = 1-442, 444-65535（关闭 QUIC，逼回落 TCP 以便解密）。
# 4. 同一 App 不要叠加其它拼多多重写。

# --- 第零层：HTTPDNS 查询（v4.3）---
# App 用明文 HTTP 向裸 IP 发 /d?dn=域名 查询，拿到网关 IP 后绕过系统 DNS 直连，
# QX 因看不到域名而无法解密（首页刷新回到原版即此原因）。拦掉后 App 回落系统 DNS。
# 注意：这两条按 URL 形态匹配，会同时影响其它使用同类 HTTPDNS 的 App（它们同样会回落系统 DNS）。
^http:\/\/(\d{1,3}\.){3}\d{1,3}(:\d+)?\/d\d*\? url reject
^http:\/\/\[[0-9a-fA-F:]+\](:\d+)?\/d\d*\? url reject

# --- 第一层：纯推广/推荐接口，直接拦截或返回空 JSON ---

# 开屏
^https?:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/cappuccino\/splash url reject
# 个人中心活动推广流
^https?:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/ktt_gateway\/activity\/feeds\/personal_home_page\/ url reject-dict
# 首页弹窗聚合、全屏弹窗
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/growth\/nagato\/app\/index\/gather url reject-dict
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/aquarius\/hungary\/global\/homepage url reject-dict
# 搜索热词推广
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/search_hotquery url reject-dict
# 订单相关推广：待收货/待评价提示、订单列表推广标签、物流/订单/个人页/聊天/猜你喜欢推荐
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/aristotle\/(unrated_order_for_unreceived_tab|query_order_list_tabs_element) url reject-dict
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/caterham\/v3\/query\/(order_express_group|my_order_group|new_chat_group|personal|likes)(\?|$) url reject-dict
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/caterham\/v2\/query\/goods_detail_with_tags url reject-dict
# 评价引导
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/engels\/(reviews\/require\/append|wait\/receive\/review) url reject-dict
# 商品页：百亿补贴引导、备用推荐
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/brand-olay\/goods_detail\/bybt_guide url reject-dict
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/alexa\/goods\/back_up url reject-dict
# 聊天页推广资源
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/zaire_biz\/chat\/resource\/get_list_data url reject-dict
# 其它推广/推荐：快捷入口、灵动岛直播推送、附加推荐
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/(phantom\/gbdbpdv\/extra|manufacturer\/cross\/shortcut\/list|dunkirk\/liveactivity\/push\/create\/url\/report|buffon\/nasus\/recommend) url reject-dict

# --- 第二层：响应体清理（本仓脚本，按接口与字段处理） ---

^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/alexa\/homepage\/hub url script-response-body https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_clean_debug.js?v=4.3
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/philo\/personal\/hub url script-response-body https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_clean_debug.js?v=4.3
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/oak\/integration\/render url script-response-body https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_clean_debug.js?v=4.3
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/(aquarius|flow)\/hungary\/(window\/)?global\/ url script-response-body https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_clean_debug.js?v=4.3
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/search url script-response-body https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_clean_debug.js?v=4.3
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/caterham\/v3\/query\/order_detail_group url script-response-body https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_clean_debug.js?v=4.3
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/aristotle\/order_list_v4 url script-response-body https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_clean_debug.js?v=4.3
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/order\/ url script-response-body https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_clean_debug.js?v=4.3

# 兜底：其余 alexa / philo 接口，脚本按字段处理底栏与月卡
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/(alexa|philo)\/ url script-response-body https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_clean_debug.js?v=4.3

# 调试兜底：其余所有 api 接口也过一遍脚本
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/ url script-response-body https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_clean_debug.js?v=4.3

# 调试：解密 m.pinduoduo.net 及全部拼多多子域（与 Surge 解密 m.pinduoduo.net 对齐），定位首页刷新的底栏来源
^https:\/\/[^\/]*(pinduoduo\.com|yangkeduo\.com|pinduoduo\.net)\/ url script-response-body https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_clean_debug.js?v=4.3

# 最后兜底（必须放在最后）：其余所有拼多多 API 响应删除 Alt-Svc 头，
# 防止 App 下拉刷新时升级到 QX 无法解密的 HTTP/3（QUIC）
^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/ url script-response-header https://raw.githubusercontent.com/kenny53/kk_mod/main/pinduoduo_header.js?v=4.3

hostname = api.pinduoduo.com, api.yangkeduo.com, m.pinduoduo.net, *.pinduoduo.com, *.yangkeduo.com
